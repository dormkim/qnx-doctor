+#include <time.h>
 #include "../common/qd.h"
 int main(int argc, char **argv) {
   const char *me = argv[1];
   setprio(0, 32);
   int imu = qd_open_fixed(argv[2]);
   for (int n = 0;; n++) {
+    uint64_t to = 150000000;                      /* never wait more than 1.5 cycles for the IMU */
+    TimerTimeout(CLOCK_MONOTONIC, _NTO_TIMEOUT_SEND | _NTO_TIMEOUT_REPLY, NULL, &to, NULL);
     if (qd_send(imu, n) < 0) perror("attitude");
