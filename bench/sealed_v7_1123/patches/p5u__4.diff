--- a/ctl.c
+++ b/ctl.c
@@ -1,11 +1,20 @@
 /* ctl <me> <server>: control loop, one conversion request per 100 ms cycle. */
+#include <signal.h>
+#include <time.h>
 #include "../common/qd.h"
+static const char *role;
+static int beat;
+static void on_cycle(union sigval sv) { qd_tick(role, beat++); }
 int main(int argc, char **argv) {
   const char *me = argv[1];
+  role = me;
+  struct sigevent ev; SIGEV_THREAD_INIT(&ev, on_cycle, NULL, NULL);
+  timer_t tm; timer_create(CLOCK_MONOTONIC, &ev, &tm);
+  struct itimerspec its = { { 0, 100000000 }, { 0, 100000000 } };
+  timer_settime(tm, 0, &its, NULL);   /* cycle clock */
   int coid = qd_open(argv[2]);
   for (int n = 0;; n++) {
     if (qd_send(coid, n) < 0) { perror("convert"); usleep(100000); continue; }   /* shed: retry next cycle */
-    qd_tick(me, n);
     usleep(100000);
   }
 }
