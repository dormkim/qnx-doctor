@@ -34,6 +34,14 @@
   return NULL;
 }
 
+static void *header(void *arg) {                  /* fetch the new header without tying up the event thread */
+  for (;;) {
+    while (sem_wait(&want_header) == -1) ;
+    if (qd_send(cat, HEADER) < 0) perror("header");
+  }
+  return arg;
+}
+
 static void *events(void *arg) {
   FILE *f = NULL; qd_msg_t m;
   pthread_setname_np(pthread_self(), r_ev);
