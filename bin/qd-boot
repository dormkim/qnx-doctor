#!/usr/bin/env python3
"""qd-boot <qemu-binary> [qemu args...]: start QEMU, wait for the QNX target to finish booting, stop it.
Exit 0 only if a boot marker appears on the serial console within QD_BOOT_TIMEOUT seconds (default 180).
QEMU's own error output is passed through so the doctor can read it."""
import os, select, subprocess, sys, time
MARKERS = [b"Startup complete", b"login:", b"# "]
def main():
    if len(sys.argv) < 2: sys.exit("usage: qd-boot <qemu> [args]")
    timeout = int(os.environ.get("QD_BOOT_TIMEOUT", "180"))
    try:
        p = subprocess.Popen(sys.argv[1:], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    except OSError as e:
        print(f"qd-boot: cannot start {sys.argv[1]}: {e}"); sys.exit(127)
    buf, end = b"", time.time() + timeout
    while time.time() < end:
        r, _, _ = select.select([p.stdout], [], [], 1)
        if r:
            chunk = os.read(p.stdout.fileno(), 4096)
            if not chunk: break
            buf += chunk
            if any(m in buf for m in MARKERS):
                p.kill(); print("qd-boot: target booted"); sys.exit(0)
        if p.poll() is not None: break
    p.kill()
    sys.stdout.write(buf.decode(errors="replace")[-4000:])
    print(f"\nqd-boot: no boot marker (qemu exit={p.poll()})"); sys.exit(1)
main()
